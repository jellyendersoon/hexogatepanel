## Server listen address and port.
UVICORN_HOST = "0.0.0.0"
UVICORN_PORT = 8000

## Use a Unix domain socket instead of host/port when running behind a local proxy.
# UVICORN_UDS = "/run/hexogate.socket"

## TLS certificate paths. Set both certfile and keyfile to enable HTTPS.
# UVICORN_SSL_CERTFILE = "/var/lib/hexogate/certs/example.com/fullchain.pem"
# UVICORN_SSL_KEYFILE = "/var/lib/hexogate/certs/example.com/key.pem"
# UVICORN_SSL_CA_TYPE = "public"

## Uvicorn process and event loop settings.
## For multi-worker all-in-one, set UVICORN_WORKERS>1 and NATS_ENABLED=1.
# UVICORN_WORKERS = 4
# UVICORN_LOOP = "auto"

## Process role. Prefer all-in-one. backend/node/scheduler are deprecated (removed in 7.0.0).
# ROLE = "all-in-one"

## Enable when Hexogate runs behind a trusted reverse proxy.
# UVICORN_PROXY_HEADERS = False
# UVICORN_FORWARDED_ALLOW_IPS = "127.0.0.1"

## Comma-separated browser origins allowed to call the API. Use "*" to allow all origins.
# ALLOWED_ORIGINS = "*"

## Dashboard mount path and API base URL used by the frontend.
# DASHBOARD_PATH = "/dashboard/"
# VITE_BASE_API = "https://example.com/"

## Subscription paths. XRAY_SUBSCRIPTION_PATH takes precedence when set.
# XRAY_SUBSCRIPTION_PATH = ""
# SUBSCRIPTION_PATH = "sub"
# USER_SUBSCRIPTION_CLIENTS_LIMIT = 10

## External config to import into v2ray format subscription.
# EXTERNAL_CONFIG = "config://..."

## Optional JSON group presentation policy: per-group host visibility, scoped
## remark overrides and ordering of the rendered subscription (see
## docs/fleet-subscription-rendering.md for the schema). The file is runtime
## data (real host ids and inbound tags) and is read once at start; a missing
## file means stock rendering. The production name
## PASARGUARD_GROUP_PRESENTATION_POLICY_PATH is accepted as an alias.
# GROUP_PRESENTATION_POLICY_PATH = "/var/lib/hexogate/group-presentation-policy.json"

## Subscription-only renderer container (sub_renderer.py, see
## docker-compose.sub-renderer.yml): the Unix socket it listens on. Production
## routes /sub/* to this socket first, so keep the default name.
# SUB_RENDERER_SOCKET = "/var/lib/pasarguard/sub-renderer-canary.socket"

## Custom page templates. Client subscription templates are stored in DB table
## `core_templates` and managed via `/api/client_template`.
# CUSTOM_TEMPLATES_DIRECTORY = "/var/lib/hexogate/templates/"
# SUBSCRIPTION_PAGE_TEMPLATE = "subscription/index.html"
# HOME_PAGE_TEMPLATE = "home/index.html"

## Database URL. SQLite is the default; PostgreSQL or MySQL are recommended for larger deployments.
# SQLALCHEMY_DATABASE_URL = "sqlite+aiosqlite:///db.sqlite3"
# SQLALCHEMY_DATABASE_URL = "postgresql+asyncpg://postgres:DB_PASSWORD@localhost:5432/hexogate"
# SQLALCHEMY_DATABASE_URL = "mysql+asyncmy://root:DB_PASSWORD@127.0.0.1/hexogate"

## Database pool settings are per process, not global. The connection ceiling is
## (POOL_SIZE + MAX_OVERFLOW) * process count, plus independently replicated services.
## The safe defaults allow up to 10 connections per process (40 for four workers).
# SQLALCHEMY_POOL_SIZE = 5
# SQLALCHEMY_MAX_OVERFLOW = 5
# SQLALCHEMY_POOL_RECYCLE = 300
# SQLALCHEMY_POOL_TIMEOUT = 5
# ECHO_SQL_QUERIES = False

## NATS connection and subjects for multi-process/node coordination.
# NATS_ENABLED = False
# NATS_URL = "nats://nats:4222"
# NATS_WORKER_SYNC_SUBJECT = "hexogate.worker_sync"
# NATS_NODE_COMMAND_SUBJECT = "hexogate.node.command"
# NATS_NODE_RPC_SUBJECT = "hexogate.node.rpc"
# NATS_SCHEDULER_RPC_SUBJECT = "hexogate.scheduler.rpc"
# NATS_NODE_LOG_SUBJECT = "hexogate.node.logs"
# NATS_NODE_RPC_TIMEOUT = 30.0
# NATS_SCHEDULER_RPC_TIMEOUT = 5.0
# NATS_NODE_COMMAND_MAX_PAYLOAD_BYTES = 900000
# NATS_NODE_UPDATE_USERS_BATCH_SIZE = 100

## NATS pub/sub channels, KV buckets, and streams.
# CORE_PUBSUB_CHANNEL = "core_hosts_updates"
# HOST_PUBSUB_CHANNEL = "host_manager_updates"
# NATS_TELEGRAM_KV_BUCKET = "hexogate_telegram"
# NATS_NODE_USER_SYNC_KV_BUCKET = "hexogate_node_user_sync"
# NATS_NODE_LIFECYCLE_KV_BUCKET = "hexogate_node_lifecycle"
# NATS_SCHEDULER_LEADER_KV_BUCKET = "hexogate_scheduler_leader"
# NATS_NOTIFICATION_STREAM = "NOTIFICATIONS"
# NATS_NOTIFICATION_SUBJECT = "notifications.queue"
# NATS_NOTIFICATION_CONSUMER = "notification_workers"
# NATS_WEBHOOK_STREAM = "WEBHOOK_NOTIFICATIONS"
# NATS_WEBHOOK_SUBJECT = "notifications.webhook"
# NATS_WEBHOOK_CONSUMER = "webhook_workers"

## We recommend adding admins with `hexogate cli`. These values create a
## static admin account and should not be used for normal deployments.
# SUDO_USERNAME = "admin"
# SUDO_PASSWORD = "admin"

## Use negative values to disable user auto-delete by default.
# USERS_AUTODELETE_DAYS = -1
# USER_AUTODELETE_INCLUDE_LIMITED_ACCOUNTS = False

## Telegram bot logging behavior.
# DO_NOT_LOG_TELEGRAM_BOT = True

## Logging settings. Rotation unit accepts "S", "M", "H", "D", "W0"-"W6", or "midnight".
# SAVE_LOGS_TO_FILE = False
# LOG_FILE_PATH = "hexogate.log"
# LOG_BACKUP_COUNT = 72
# LOG_ROTATION_ENABLED = False
# LOG_ROTATION_INTERVAL = 1
# LOG_ROTATION_UNIT = "H"
# LOG_MAX_BYTES = 10485760
# LOG_LEVEL = "INFO"

## JWT access token lifetime in minutes.
# JWT_ACCESS_TOKEN_EXPIRE_MINUTES = 1440

## Usage recording. Node stats recording is only available for PostgreSQL/TimescaleDB.
# DISABLE_RECORDING_NODE_USAGE = False
# ENABLE_RECORDING_NODES_STATS = False
# RESET_USER_USAGE_CLEAN_CHART_DATA = False

## Background job intervals in seconds.
# JOB_CORE_HEALTH_CHECK_INTERVAL = 10
# JOB_RECORD_NODE_USAGES_INTERVAL = 30
# JOB_RECORD_USER_USAGES_INTERVAL = 10
# JOB_REVIEW_USERS_INTERVAL = 30
# JOB_REVIEW_ADMIN_LIMITS_INTERVAL = 10
# JOB_SEND_NOTIFICATIONS_INTERVAL = 30
# JOB_GATHER_NODES_STATS_INTERVAL = 25
# JOB_REMOVE_OLD_INBOUNDS_INTERVAL = 600
# JOB_REMOVE_EXPIRED_USERS_INTERVAL = 3600
# JOB_RESET_USER_DATA_USAGE_INTERVAL = 600
# JOB_RESET_NODE_USAGE_INTERVAL = 60
# JOB_CHECK_NODE_LIMITS_INTERVAL = 60
# JOB_CLEANUP_SUBSCRIPTION_UPDATES_INTERVAL = 600

## Node auto-reconnect. After NODE_AUTO_RECONNECT_AFTER_FAILURES consecutive failed
## health checks the panel reconnects the node itself; later attempts back off
## exponentially (2, 4, 8 ... checks) up to NODE_AUTO_RECONNECT_MAX_BACKOFF_CHECKS
## checks between attempts (60 checks is 10 minutes at the default 10s interval).
# NODE_AUTO_RECONNECT_AFTER_FAILURES = 3
# NODE_AUTO_RECONNECT_MAX_BACKOFF_CHECKS = 60

## Developer and test flags.
# DOCS = False
# DEBUG = False
# TESTING = False

## Experimental features.
# STOP_NODES_ON_SHUTDOWN = True
